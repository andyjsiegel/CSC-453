/* Compile with 'dot -Tpng graph.gv > graph.png' */

digraph problem1 { 
   standard [
      shape="record"; 
      label="{int | float}";
   ];

   sytab1 [
      shape="record"; 
      label="{int y}"
   ];

   sytab2 [
      shape="record";
      label="{char x | float y}"
   ];

   sytab1 [
      shape="record"; 
      label="{void foo(int)}"
   ];

   sytab1 -> sytab2
   sytab2 -> sytab3
   sytab3 -> standard   
}