/* Compile with 'dot -Tpng graph.gv > graph.png' */

digraph problem1 { 
   standard [
      shape="record"; 
      label="{int | float}";
   ];

   sytab3 [
      shape="record"; 
      label="{int y}"
   ];

   sytab2 [
      shape="record";
      label="{float x | float y}"
   ];

   sytab1 [
      shape="record"; 
      label="{void foo(char)}"
   ];

   sytab3 -> sytab2
   sytab2 -> sytab1
   sytab1 -> standard   
}