PROGRAM P;
 
VAR I : REAL;
VAR J : REAL;
BEGIN
   J := 2.0;
   I := 
      ((J + 1.0) * 
      (J + 2.0) * 
      (J + 3.0) * 
      (J + 4.0) * 
      (J + 5.0) * 
      (J + 6.0) * 
      (J + 7.0) * 
      (J + 8.0) * 
      (J + 9.0) * 
      (J + 10.0) * 
      (J + 11.0) * 
      (J + 12.0) * 
      (J + 13.0) * 
      (J + 14.0) * 
      (J + 15.0) * 
      (J + 16.0) * 
      (J + 17.0) * 
      (J + 18.0) * 
      (J + 19.0) * 
      (J + 20.0)) -
      ((J + 1.0) * 
      (J + 2.0) * 
      (J + 3.0) * 
      (J + 4.0) * 
      (J + 5.0) * 
      (J + 6.0) * 
      (J + 7.0) * 
      (J + 8.0) * 
      (J + 9.0) * 
      (J + 10.0) * 
      (J + 11.0) * 
      (J + 12.0) * 
      (J + 13.0) * 
      (J + 14.0) * 
      (J + 15.0) * 
      (J + 16.0) * 
      (J + 17.0) * 
      (J + 18.0) * 
      (J + 19.0) * 
      (J + 20.0)); 
   WRITE I; WRITELN;
END.
