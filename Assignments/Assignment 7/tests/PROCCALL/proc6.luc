PROGRAM P;

VAR x : REAL;

PROCEDURE Q (
   a : REAL;
   b : REAL;
   c : REAL;
   d : REAL;
   e : REAL;
   f : REAL;
   g : REAL;
   h : REAL);
BEGIN
   b := 10.1; 
   g := 20.1;
   x := a + b + c + d + e + f + g + h;
END;

BEGIN
   x := 23.45; 
   Q(1.1, 2.1, 3.1, 4.1, 5.1, 6.1, 7.1, 8.1);
   WRITE TRUNC(x) - 57; WRITELN;
END.
