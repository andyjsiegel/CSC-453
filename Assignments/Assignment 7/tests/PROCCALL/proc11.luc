PROGRAM P;

TYPE T = RECORD[a : INTEGER; b : INTEGER];

VAR r : T;
VAR x : INTEGER;

PROCEDURE Q (
   a1 : INTEGER;
   a2 : INTEGER;
   a3 : INTEGER;
   a4 : INTEGER;
   a5 : INTEGER;
   a6 : INTEGER;
   a7 : INTEGER;
   VAR b : T;
   c : INTEGER);
BEGIN
   b.a := a1; 
   b.b := c;
END;

BEGIN
   r.a := 15; 
   r.b := 25; 
   Q(13, 1, 1, 1, 1, 1, 1, r, 17);
   WRITE r.a + r.b - 30; WRITELN;
END.
